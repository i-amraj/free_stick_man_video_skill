{
  "total_duration": 103.41,
  "beats": [
    {
      "id": "beat_1",
      "text": "रात के तीन बजकर तैंतीस मिनट। तुम्हारा फ़ोन बजता है।",
      "start": 0.0,
      "speech_end": 4.94,
      "total_end": 5.54,
      "duration": 4.94,
      "pause": 0.6
    },
    {
      "id": "beat_2",
      "text": "स्क्रीन पर नंबर चमकता है — तुम्हारा ही नंबर।",
      "start": 5.54,
      "speech_end": 9.53,
      "total_end": 10.33,
      "duration": 3.98,
      "pause": 0.8
    },
    {
      "id": "beat_3",
      "text": "तुम कॉल उठाते हो। दूसरी तरफ़ तुम्हारी अपनी आवाज़: दरवाज़ा मत खोलना।",
      "start": 10.33,
      "speech_end": 16.59,
      "total_end": 17.29,
      "duration": 6.26,
      "pause": 0.7
    },
    {
      "id": "beat_4",
      "text": "कॉल लॉग में लिखा है — आउटगोइंग। कॉल तुमने की थी... पर तुमने की ही नहीं।",
      "start": 17.29,
      "speech_end": 23.82,
      "total_end": 24.62,
      "duration": 6.53,
      "pause": 0.8
    },
    {
      "id": "beat_5",
      "text": "तभी दरवाज़े पर दस्तक होती है। तीन हल्की, एक ज़ोर की — बिल्कुल तुम्हारे अंदाज़ में।",
      "start": 24.62,
      "speech_end": 32.06,
      "total_end": 33.06,
      "duration": 7.44,
      "pause": 1.0
    },
    {
      "id": "beat_6",
      "text": "तुम दबे पाँव पीपहोल से झाँकते हो — गलियारा खाली है।",
      "start": 33.06,
      "speech_end": 37.86,
      "total_end": 38.56,
      "duration": 4.8,
      "pause": 0.7
    },
    {
      "id": "beat_7",
      "text": "तभी उसी नंबर से मैसेज आता है: दोबारा देखो। पीपहोल पूरी बात नहीं दिखाता।",
      "start": 38.56,
      "speech_end": 45.59,
      "total_end": 46.49,
      "duration": 7.03,
      "pause": 0.9
    },
    {
      "id": "beat_8",
      "text": "तुम फिर झाँकते हो। कोई नहीं। पर दरवाज़े के नीचे से पानी आ रहा है।",
      "start": 46.49,
      "speech_end": 52.61,
      "total_end": 53.41,
      "duration": 6.12,
      "pause": 0.8
    },
    {
      "id": "beat_9",
      "text": "गीले पैरों के निशान दरवाज़े से तुम्हारे कमरे तक आ रहे हैं — और उनका नाप बिल्कुल तुम्हारे पैरों जितना है।",
      "start": 53.41,
      "speech_end": 62.2,
      "total_end": 63.1,
      "duration": 8.78,
      "pause": 0.9
    },
    {
      "id": "beat_10",
      "text": "कुंडी अंदर से लगी है। तो अंदर आया कौन?",
      "start": 63.1,
      "speech_end": 67.01,
      "total_end": 68.21,
      "duration": 3.91,
      "pause": 1.2
    },
    {
      "id": "beat_11",
      "text": "फ़ोन फिर बजता है। वही आवाज़: अब पीछे मत मुड़ना।",
      "start": 68.21,
      "speech_end": 73.13,
      "total_end": 74.03,
      "duration": 4.92,
      "pause": 0.9
    },
    {
      "id": "beat_12",
      "text": "तुम जम जाते हो — क्योंकि इस बार आवाज़ फ़ोन से नहीं आई। वो ठीक तुम्हारे पीछे से आई है।",
      "start": 74.03,
      "speech_end": 81.61,
      "total_end": 82.81,
      "duration": 7.58,
      "pause": 1.2
    },
    {
      "id": "beat_13",
      "text": "सारे सुराग जोड़ो — अपना नंबर, दस्तक की लय, खाली गलियारा, अंदर आते निशान।",
      "start": 82.81,
      "speech_end": 90.56,
      "total_end": 91.26,
      "duration": 7.75,
      "pause": 0.7
    },
    {
      "id": "beat_14",
      "text": "दस्तक किसने दी — बाहर वाले ने, या पीछे खड़े उसी ने?",
      "start": 91.26,
      "speech_end": 96.69,
      "total_end": 97.49,
      "duration": 5.42,
      "pause": 0.8
    },
    {
      "id": "beat_15",
      "text": "जवाब कमेंट में लिखो। अगली रील में इस रहस्य का सच दिखाएँगे।",
      "start": 97.49,
      "speech_end": 102.91,
      "total_end": 103.41,
      "duration": 5.42,
      "pause": 0.5
    }
  ]
}